 "vo": [
  {
   "t": 0.15,
   "text": "Season finale. The Shadow Shogun."
  },
  {
   "t": 2.6,
   "text": "Ninja. I sent them all.",
   "who": "SHOGUN"
  },
  {
   "t": 4.3,
   "text": "The goblin. The ogre. The phantom. The slimes. The titan. All at once."
  },
  {
   "t": 8.6,
   "text": "Phone away. Alarm across the room. Two minutes. No candy. Clothes ready.",
   "who": "NINJA"
  },
  {
   "t": 13.2,
   "text": "You missed one day. You already failed. Just quit.",
   "who": "SHOGUN"
  },
  {
   "t": 16.2,
   "text": "The ninja fell..."
  },
  {
   "t": 17.5,
   "text": "Everyone misses a day. Champions never miss two.",
   "who": "MASTER"
  },
  {
   "t": 21.05,
   "text": "I missed one. I won't miss two.",
   "who": "NINJA"
  },
  {
   "t": 22.85,
   "text": "Impossible!",
   "who": "SHOGUN"
  },
  {
   "t": 24.0,
   "text": "Never miss twice!",
   "who": "NINJA"
  },
  {
   "t": 25.35,
   "text": "The shadow broke. The dojo was free."
  },
  {
   "t": 27.9,
   "text": "This isn't over, ninja. Season two.",
   "who": "SHOGUN"
  },
  {
   "t": 30.65,
   "text": "Season two is coming. Follow so you don't miss it."
  }
 ],
