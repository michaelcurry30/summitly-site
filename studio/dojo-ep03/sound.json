  {
   "t": 0.15,
   "text": "Episode three. The Later Phantom."
  },
  {
   "t": 2.4,
   "text": "Training day. The task is waiting..."
  },
  {
   "t": 4.75,
   "text": "Do it... later...",
   "who": "PHANTOM"
  },
  {
   "t": 6.35,
   "text": "Later became tomorrow. Tomorrow became never."
  },
  {
   "t": 9.5,
   "text": "Why can't I just start?",
   "who": "NINJA"
  },
  {
   "t": 11.0,
   "text": "The phantom fears one thing. Two minutes. Start so small you can't say no.",
   "who": "MASTER"
  },
  {
   "t": 16.3,
   "text": "Just two minutes.",
   "who": "NINJA"
  },
  {
   "t": 17.45,
   "text": "No! Not now!",
   "who": "PHANTOM"
  },
  {
   "t": 19.05,
   "text": "Now!",
   "who": "NINJA"
  },
  {
   "t": 19.85,
   "text": "Two minutes became an hour. The phantom faded away."
  },
  {
   "t": 23.35,
   "text": "Clever ninja... but the Sugar Slimes are already in your kitchen.",
   "who": "PHANTOM"
  },
  {
   "t": 27.55,
   "text": "Episode four. Follow so you don't miss it."
  }
 ],
