 "vo": [
  {
   "t": 0.15,
   "text": "The first thing you touch every morning... is your phone."
  },
  {
   "t": 3.4,
   "text": "Emails. News. Notifications."
  },
  {
   "t": 5.8,
   "text": "Before you're even out of bed..."
  },
  {
   "t": 7.6,
   "text": "your morning belongs to everyone else."
  },
  {
   "t": 10.0,
   "text": "Just a quick check.",
   "who": "NINJA"
  },
  {
   "t": 11.6,
   "text": "Thirty minutes later..."
  },
  {
   "t": 13.4,
   "text": "Not today.",
   "who": "NINJA"
  },
  {
   "t": 15.2,
   "text": "The fix? No phone for the first thirty minutes."
  },
  {
   "t": 18.2,
   "text": "Water. Stretch. Plan your day."
  },
  {
   "t": 20.6,
   "text": "Your morning. Your rules."
  },
  {
   "t": 22.6,
   "text": "Win the morning first. The phone can wait."
  },
  {
   "t": 25.9,
   "text": "Grab the free habit tracker. Link in bio."
  }
 ],
