 "vo": [
  {
   "t": 0.15,
   "text": "Your hardest task... is a frog."
  },
  {
   "t": 2.6,
   "text": "So you dodge it all day."
  },
  {
   "t": 4.4,
   "text": "Easy stuff first. Emails. Notes. Snacks."
  },
  {
   "t": 7.2,
   "text": "But the frog just sits there."
  },
  {
   "t": 9.0,
   "text": "I'll do it tonight.",
   "who": "NINJA"
  },
  {
   "t": 10.6,
   "text": "By tonight... you're exhausted."
  },
  {
   "t": 12.6,
   "text": "Not again.",
   "who": "NINJA"
  },
  {
   "t": 14.4,
   "text": "So eat the frog. Do the hardest thing first."
  },
  {
   "t": 17.4,
   "text": "While your energy is fresh."
  },
  {
   "t": 19.2,
   "text": "Then the rest of the day feels easy."
  },
  {
   "t": 21.8,
   "text": "Hardest thing first. Every morning."
  },
  {
   "t": 24.8,
   "text": "Grab the free habit tracker. Link in bio."
  }
 ],
