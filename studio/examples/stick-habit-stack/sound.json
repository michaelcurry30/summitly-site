 "vo": [
  {
   "t": 0.15,
   "text": "New habits don't stick."
  },
  {
   "t": 2.2,
   "text": "You tell yourself..."
  },
  {
   "t": 3.6,
   "text": "I'll remember.",
   "who": "NINJA"
  },
  {
   "t": 5.0,
   "text": "You won't."
  },
  {
   "t": 6.6,
   "text": "Not anymore.",
   "who": "NINJA"
  },
  {
   "t": 8.6,
   "text": "The fix? Habit stacking."
  },
  {
   "t": 10.6,
   "text": "Chain the new habit to an old one."
  },
  {
   "t": 13.0,
   "text": "After coffee... read one page."
  },
  {
   "t": 15.8,
   "text": "After brushing teeth... one minute of stretching."
  },
  {
   "t": 19.2,
   "text": "The old habit becomes the trigger."
  },
  {
   "t": 21.8,
   "text": "After I do this... I will do that.",
   "speed": 0.98
  },
  {
   "t": 24.9,
   "text": "Follow for more."
  }
 ],
