 "vo": [
  {
   "t": 0.15,
   "text": "Why you procrastinate... It's not laziness."
  },
  {
   "t": 3.0,
   "text": "The task just feels too big. And scary."
  },
  {
   "t": 5.6,
   "text": "So your brain runs."
  },
  {
   "t": 7.2,
   "text": "Snacks. Emails. A spotless desk."
  },
  {
   "t": 9.9,
   "text": "I'll do it later.",
   "who": "NINJA"
  },
  {
   "t": 11.4,
   "text": "But the monster keeps growing."
  },
  {
   "t": 13.6,
   "text": "Enough.",
   "who": "NINJA"
  },
  {
   "t": 15.2,
   "text": "The trick? Start for ten minutes."
  },
  {
   "t": 17.6,
   "text": "Just ten. That's it."
  },
  {
   "t": 19.6,
   "text": "Once you start... the monster shrinks."
  },
  {
   "t": 22.4,
   "text": "It was never that big."
  },
  {
   "t": 24.6,
   "text": "Start for ten minutes. Just start.",
   "speed": 0.98
  },
  {
   "t": 27.0,
   "text": "Follow for more."
  }
 ],
