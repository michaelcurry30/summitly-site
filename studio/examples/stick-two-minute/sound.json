 "vo": [
  {
   "t": 0.15,
   "text": "Your habit isn't too hard. It's too big."
  },
  {
   "t": 3.0,
   "text": "Read fifty pages a night?"
  },
  {
   "t": 4.8,
   "text": "Day one... crushed."
  },
  {
   "t": 6.8,
   "text": "By day two, it's... later."
  },
  {
   "t": 9.0,
   "text": "Nope.",
   "who": "NINJA"
  },
  {
   "t": 10.4,
   "text": "Use the two-minute rule."
  },
  {
   "t": 12.2,
   "text": "Shrink it until it takes two minutes."
  },
  {
   "t": 14.6,
   "text": "Read one page. Done."
  },
  {
   "t": 16.6,
   "text": "Again tomorrow. And the next day."
  },
  {
   "t": 19.4,
   "text": "Showing up becomes the habit..."
  },
  {
   "t": 21.4,
   "text": "and the pages grow from there."
  },
  {
   "t": 24.6,
   "text": "Make it so small you can't say no.",
   "speed": 0.96
  },
  {
   "t": 27.7,
   "text": "Follow for more."
  }
 ],
