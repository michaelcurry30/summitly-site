 "vo": [
  {
   "t": 0.15,
   "text": "Still waiting to feel motivated?"
  },
  {
   "t": 2.3,
   "text": "Motivation is a liar."
  },
  {
   "t": 4.4,
   "text": "It shows up... then floats away."
  },
  {
   "t": 7.0,
   "text": "So he waits... for the perfect mood."
  },
  {
   "t": 9.6,
   "text": "His excuse? When I feel like it."
  },
  {
   "t": 12.2,
   "text": "No more waiting.",
   "who": "NINJA"
  },
  {
   "t": 14.6,
   "text": "Start before you feel ready."
  },
  {
   "t": 17.0,
   "text": "Action comes first..."
  },
  {
   "t": 19.0,
   "text": "then motivation catches up."
  },
  {
   "t": 22.8,
   "text": "Action first. Motivation follows.",
   "speed": 0.98
  },
  {
   "t": 26.0,
   "text": "Follow for more."
  }
 ],
