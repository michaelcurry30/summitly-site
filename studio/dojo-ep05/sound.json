 "vo": [
  {
   "t": 0.15,
   "text": "Episode five. The Couch Titan."
  },
  {
   "t": 2.35,
   "text": "After work. Just a quick sit..."
  },
  {
   "t": 4.3,
   "text": "Sit... stay... forever...",
   "who": "TITAN"
  },
  {
   "t": 6.8,
   "text": "The titan swallowed his whole evening."
  },
  {
   "t": 9.0,
   "text": "I skipped training. Again.",
   "who": "NINJA"
  },
  {
   "t": 10.85,
   "text": "Don't fight the titan at night. Lay out your clothes. Then just ten minutes.",
   "who": "MASTER"
  },
  {
   "t": 15.95,
   "text": "Clothes ready. Shoes on. Ten minutes.",
   "who": "NINJA"
  },
  {
   "t": 18.2,
   "text": "Sit down! Sit down!",
   "who": "TITAN"
  },
  {
   "t": 20.8,
   "text": "Never!",
   "who": "NINJA"
  },
  {
   "t": 21.65,
   "text": "Ten minutes became a habit. The titan crumbled."
  },
  {
   "t": 24.75,
   "text": "You beat us all... but the Shadow Shogun sent us. And he is coming for you.",
   "who": "TITAN"
  },
  {
   "t": 29.85,
   "text": "The season finale. Follow so you don't miss it."
  }
