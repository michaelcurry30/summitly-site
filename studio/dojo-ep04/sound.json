   "text": "No! Not the trash!",
   "who": "SLIME"
  },
  {
   "t": 16.1,
   "text": "Gone!",
   "who": "NINJA"
  },
  {
   "t": 16.95,
   "text": "Now the first thing he sees... is fruit."
  },
  {
   "t": 19.4,
   "text": "You got us... but the Couch Titan is way bigger. And he never gets up.",
   "who": "SLIME"
  },
  {
   "t": 23.0,
   "text": "Episode five. Follow so you don't miss it."
  }
