   "t": 0.15,
   "text": "Episode four. The Sugar Slimes."
  },
  {
   "t": 2.45,
   "text": "Midnight. The kitchen glows..."
  },
  {
   "t": 4.25,
   "text": "Eat us! Just one more!",
   "who": "SLIME"
  },
  {
   "t": 5.45,
