  },
  {
   "t": 7.2,
   "text": "Ugh. I feel terrible.",
   "who": "NINJA"
  },
  {
   "t": 8.65,
   "text": "You see them, you eat them. Hide the candy. Put the fruit where you can see it.",
   "who": "MASTER"
