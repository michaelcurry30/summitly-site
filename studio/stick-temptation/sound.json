  {
   "t": 0.15,
   "text": "Hate working out? Try this sneaky trick."
  },
  {
   "t": 3.0,
   "text": "Every evening, your gym bag waits."
  },
  {
   "t": 5.0,
   "text": "And every evening... the couch wins."
  },
  {
   "t": 7.4,
   "text": "I'm too tired.",
   "who": "NINJA"
  },
  {
   "t": 8.9,
   "text": "But you never skip your favorite show."
  },
  {
   "t": 11.2,
   "text": "Not anymore.",
   "who": "NINJA"
  },
  {
   "t": 13.2,
   "text": "Only watch that show... while you work out."
  },
  {
   "t": 16.0,
   "text": "Only play that podcast... on your run."
  },
  {
   "t": 18.6,
   "text": "Now you actually want to go."
  },
  {
   "t": 20.6,
   "text": "Researchers call it temptation bundling."
  },
  {
   "t": 23.0,
   "text": "Pair what you need with what you love."
  },
  {
   "t": 25.9,
   "text": "Grab the free habit tracker. Link in bio."
  }
 ],
